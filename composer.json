{
	"name": "projection-agency/florank-wordpress",
	"description": "Florank for WordPress: publish Florank articles, sync SEO fields, JSON-LD and IndexNow.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://florank.ai",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
	},
	"autoload": {
		"psr-4": {
			"Florank\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Florank\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0.30"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit --testsuite unit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	}
}
