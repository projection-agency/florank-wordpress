#. Plugin Name of the plugin
#. Author of the plugin
#: florank.php src/Admin/SettingsPage.php:83 src/Admin/SettingsPage.php:84 src/Admin/SettingsPage.php:228
msgid "Florank"
msgstr "Florank"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: florank.php
msgid "https://florank.ai"
msgstr "https://florank.ai"

#. Description of the plugin
#: florank.php
msgid "Connect this WordPress site to Florank to publish articles and sync SEO fields."
msgstr "Підключіть сайт WordPress до Florank, щоб публікувати статті й синхронізувати SEO-поля."

