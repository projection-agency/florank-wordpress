#. translators: %s: WordPress user login.
#: src/Auth/RunAsUser.php:116
#, php-format
msgid "The WordPress user Florank publishes as (%s) cannot edit posts or upload files. Choose another user on the Florank page in WordPress."
msgstr "Користувач WordPress, від імені якого публікує Florank (%s), не може редагувати записи або завантажувати файли. Оберіть іншого користувача на сторінці Florank у WordPress."

#: src/Posts/PostService.php:138
msgid "Post not found"
msgstr "Запис не знайдено"

#: src/Posts/PostService.php:155
msgid "Could not delete post"
msgstr "Не вдалося видалити запис"

#: src/Posts/PostService.php:286
msgid "The WordPress user Florank publishes as is not allowed to do this. Choose another user on the Florank page in WordPress."
msgstr "Користувач WordPress, від імені якого публікує Florank, не має на це прав. Оберіть іншого користувача на сторінці Florank у WordPress."

